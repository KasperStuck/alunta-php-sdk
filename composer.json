{
  "name": "kasperstuck/alunta-php-sdk",
  "description": "Framework-free client for the Alunta public API.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^2.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "guzzlehttp/psr7": "^2.9 || ^3.0",
    "pestphp/pest": "^4.7 || ^5.3",
    "phpstan/phpstan": "^2.3"
  },
  "autoload": {
    "psr-4": {
      "KasperStuck\\Alunta\\Sdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KasperStuck\\Alunta\\Sdk\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "pest --compact",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G"
  }
}
